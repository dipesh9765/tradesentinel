# =================================================================
# KitePulse AI - Environment Configuration Template
# =================================================================
# NOTE: Filling this file is 100% OPTIONAL!
# All API keys, broker secrets, access tokens, and notification webhooks
# can be entered and managed directly via the Web UI:
#   -> Open http://localhost:5173
#   -> Click "Settings" (Gear Icon)
#   -> Enter your credentials in the Encrypted Vault
#
# Credentials entered via the Web UI are encrypted with your Master Password
# using PBKDF2 + AES-128 (Fernet) and stored securely in SQLite.
#
# If you prefer to supply default credentials via environment variables
# (e.g. for headless or automated environments), copy this file to .env:
#   cp .env.example .env (or copy .env.example .env on Windows)
# =================================================================

# Zerodha Kite Connect Credentials
# Obtain from https://kite.trade/ developer console (or set via Web UI Settings)
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Optional: Pre-authenticated tokens (can also be generated/entered via Web UI)
KITE_ACCESS_TOKEN=
KITE_REQUEST_TOKEN=

# Google Gemini API Key
# Obtain from https://aistudio.google.com/ (or set via Web UI Settings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI and Anthropic keys are entered in the Web UI (Settings -> AI Provider & Model)
# and stored encrypted; only Gemini has an optional environment fallback.

# Risk discipline (all optional; defaults shown)
MAX_DAILY_LOSS=2000
MAX_TRADES_PER_DAY=5
MAX_CONSECUTIVE_LOSSES=3
LOSS_STREAK_PAUSE_MINUTES=60

# Operational Trading Mode: "PAPER" (virtual simulation) or "LIVE" (Zerodha MIS)
# Can also be toggled anytime in the top-right corner of the Web UI
TRADING_MODE=PAPER
